---
/**
 * Theme toggle — delegation-based so it survives View Transitions swaps.
 * The actual theme boot script lives inline in Base.astro <head> to avoid FOUC.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-live="polite">
  <span class="theme-toggle__label" data-theme-label>DARK</span>
</button>

<style>
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    padding: 8px 14px;
    border: 1px solid var(--line);
    color: var(--ink-2);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .theme-toggle__label::before {
    content: '◐ ';
  }

  @media (max-width: 480px) {
    .theme-toggle {
      padding: 8px 10px;
    }

    /* icon-only on narrow screens; the aria-label still names the action */
    .theme-toggle__label {
      font-size: 0;
    }

    .theme-toggle__label::before {
      content: '◐';
      font-size: 14px;
    }
  }
</style>

<script>
  const KEY = 'tt-theme';

  function currentTheme(): string {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function syncLabels() {
    const next = currentTheme() === 'dark' ? 'LIGHT' : 'DARK';
    document
      .querySelectorAll<HTMLElement>('[data-theme-label]')
      .forEach((el) => (el.textContent = next));
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) =>
        btn.setAttribute('aria-label', `Switch to ${next.toLowerCase()} theme`),
      );
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
    if (!btn) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem(KEY, next);
    syncLabels();
  });

  document.addEventListener('astro:page-load', syncLabels);
</script>
