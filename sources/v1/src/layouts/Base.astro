---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';

import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CF_ANALYTICS_TOKEN } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  noindex?: boolean;
  /** Skip the shared site chrome (used by the internal roadmap page). */
  bare?: boolean;
  /** Extra JSON-LD structured data, serialized as-is. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  path,
  lang = 'en',
  noindex = false,
  bare = false,
  jsonLd,
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

/* Mirror deployments (non-root base) must never be indexed. */
const effectiveNoindex = noindex || import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f0e9" />

    <SEO {title} {description} {path} noindex={effectiveNoindex} />

    <link rel="icon" href={base + 'favicon.ico'} sizes="32x32" />
    <link rel="icon" href={base + 'icons/favicon-32.png'} type="image/png" sizes="32x32" />
    <link rel="icon" href={base + 'icons/favicon-192.png'} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={base + 'icons/apple-touch-icon.png'} />
    <link rel="manifest" href={base + 'icons/site.webmanifest'} />
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Theme boot: runs before paint, survives view-transition swaps. -->
    <script is:inline>
      (function () {
        const apply = () => {
          let theme = 'light';
          try {
            theme =
              localStorage.getItem('tt-theme') ??
              (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          } catch {}
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />

    {
      /* production builds only — local dev must not pollute the stats */
      CF_ANALYTICS_TOKEN && import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <!-- Reveal-on-scroll: respects prefers-reduced-motion via CSS fallback. -->
    <script>
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
