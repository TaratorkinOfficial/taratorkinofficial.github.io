---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import GameCard from '../components/GameCard.astro';
import { GAMES, GROUPS, type GameGroup } from '../data/games';
import { TEAM } from '../data/team';
import { SITE, STATS } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const SERVICES = [
  { title: 'Rapid prototyping', text: 'Quick, playable prototypes that validate core loops' },
  { title: 'Production & polish', text: 'Robust Unity pipelines with great art direction' },
  { title: 'Live-ops & support', text: 'A/B testing, events, retention optimization' },
  { title: 'Monetization', text: 'IAP economy, rewarded ads, fair player experience' },
  { title: 'Data-driven development', text: 'Analytics-informed decisions for retention & growth' },
  { title: 'Full-cycle development', text: 'From concept to launch with live-ops support' },
];

const groupOrder: GameGroup[] = ['collab', 'studio', 'experience'];
const groupCounts = Object.fromEntries(
  groupOrder.map((g) => [g, GAMES.filter((x) => x.group === g).length]),
) as Record<GameGroup, number>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/icons/favicon-512.png`,
  description: SITE.description,
  foundingDate: String(SITE.foundingYear),
  email: SITE.email,
  sameAs: [SITE.linkedin],
};
---

<Base
  title="Taratorkin Official — independent mobile games studio"
  description="Independent mobile games studio crafting polished, retention-driven hyper, hybrid, and casual titles since 2020. 19 games shipped, 10M+ downloads."
  path="/"
  jsonLd={jsonLd}
>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow eyebrow--accent hero__eyebrow">
        <span class="hero__dot"></span> Independent games studio · est. {SITE.foundingYear}
      </p>
      <h1 class="hero__title display">
        We make mobile games people<br class="hero__br" /> come <em>back</em> to.
      </h1>
      <p class="hero__lede">
        Hyper, hybrid & casual titles — designed, built, and operated by a four-person
        full-stack team. Easy to learn, hard to put down.
      </p>
      <div class="hero__actions">
        <a href="#work" class="btn btn--accent">See the work ↓</a>
        <a href={base + 'pitch'} class="btn">Publisher pitch</a>
      </div>
    </div>
  </section>

  <Marquee />

  <!-- ===== STATS ===== -->
  <section class="stats" aria-label="Studio in numbers">
    <div class="container stats__grid">
      {
        STATS.map((s) => (
          <div class="stats__item">
            <span class="stats__value mono">{s.value}</span>
            <span class="stats__label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== WORK ===== -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <span class="idx">01 / Portfolio</span>
        <h2 class="section-title">The <em>work</em></h2>
      </div>

      <div class="filters" role="group" aria-label="Filter games by group">
        <button type="button" class="filters__btn is-active" data-filter="all" aria-pressed="true">
          All <span class="filters__count">{GAMES.length}</span>
        </button>
        {
          groupOrder.map((g) => (
            <button type="button" class="filters__btn" data-filter={g} aria-pressed="false">
              {GROUPS[g].label} <span class="filters__count">{groupCounts[g]}</span>
            </button>
          ))
        }
      </div>
      <p class="filters__note mono" data-filter-note>
        {GAMES.length} titles · collaborations, studio releases & prior team credits
      </p>

      <div class="work-grid" data-games-grid>
        {GAMES.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <!-- ===== STUDIO / ABOUT ===== -->
  <section class="section" id="studio">
    <div class="container">
      <div class="section-head">
        <span class="idx">02 / Studio</span>
        <h2 class="section-title">Built like a <em>bigger</em> studio</h2>
      </div>

      <div class="about">
        <div class="about__copy">
          <p>
            <strong>Taratorkin Official</strong> is an independent mobile games studio with a
            clear focus: build polished, retention-driven experiences that players return to.
            Since 2020 our core team has been designing, prototyping and shipping titles across
            the hyper, hybrid, and casual space.
          </p>
          <p>
            We combine fast iteration with production discipline to deliver both hits and
            steady-grossing live games. Our approach blends creative design, lean engineering
            and data-informed live-ops.
          </p>
          <p>
            <strong>AI is part of our pipeline.</strong> We use it to multiply creative variants,
            accelerate balance passes, and rapidly iterate on UA hooks — but every AI-generated
            output is benchmarked against a human-made baseline before shipping. Speed never
            comes at the cost of quality, and a compact team operates at the throughput of a
            much larger studio.
          </p>
          <p>
            From rapid prototyping to full production and long-term live-ops, we cover the
            entire lifecycle of a mobile game. Our toolbox spans A/B testing, event-driven
            content, retention & LTV optimization, IAP economy design, and rewarded-ad
            mediation — across hyper, hybrid, and casual genres, all under one roof.
          </p>
        </div>

        <ol class="services">
          {
            SERVICES.map((s, i) => (
              <li class="services__item reveal">
                <span class="services__num mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="services__title">{s.title}</h3>
                  <p class="services__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== TEAM ===== -->
  <section class="section" id="team">
    <div class="container">
      <div class="section-head">
        <span class="idx">03 / People</span>
        <h2 class="section-title">Four people. <em>Full stack.</em></h2>
      </div>

      <div class="team">
        {
          TEAM.map((m) => (
            <article class="member reveal">
              <Image
                src={m.photo}
                alt={`Portrait of ${m.name}`}
                width={480}
                widths={[240, 480]}
                sizes="(max-width: 720px) 40vw, 240px"
                class="member__photo"
                loading="lazy"
              />
              <div class="member__body">
                <h3 class="member__name">{m.name}</h3>
                <p class="member__role mono">{m.role}</p>
                <p class="member__bio">{m.bio}</p>
                <p class="member__tags">
                  {m.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </p>
                <p class="member__links">
                  {m.links.map((l) => (
                    <a href={l.url} target="_blank" rel="noopener" class="link">
                      {l.label} ↗
                    </a>
                  ))}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PUBLISHERS BANNER ===== -->
  <section class="pub-banner">
    <div class="container pub-banner__inner">
      <h2 class="pub-banner__title display">Publishing or scouting prototypes?</h2>
      <p class="pub-banner__text">
        4-week sprints, dual-platform builds, UA creatives included. See how we work with
        publishers.
      </p>
      <a href={base + 'pitch'} class="btn pub-banner__btn">Read the pitch ↗</a>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="section-head">
        <span class="idx">04 / Contact</span>
        <h2 class="section-title">Let's <em>talk</em></h2>
      </div>

      <div class="contact">
        <a href={`mailto:${SITE.email}`} class="contact__email display">{SITE.email}</a>
        <div class="contact__actions">
          <button type="button" class="btn" data-copy-email data-email={SITE.email}>
            Copy address
          </button>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn">LinkedIn ↗</a>
        </div>
        <p class="contact__note">
          Partnerships, publishing, or listing your game — we answer every serious email.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== hero ===== */
  .hero {
    padding-block: clamp(72px, 11vw, 150px);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    animation: blink 2s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  .hero__title {
    font-size: clamp(34px, 6.6vw, 84px);
    line-height: 1.04;
    max-width: 18ch;
  }

  .hero__title em {
    font-style: normal;
    color: var(--accent-ink);
  }

  .hero__lede {
    max-width: 52ch;
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--ink-2);
    margin-top: 28px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 720px) {
    .hero__br {
      display: none;
    }
  }

  /* ===== stats ===== */
  .stats {
    border-bottom: 1px solid var(--line-strong);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(24px, 3.4vw, 44px) 20px;
    border-left: 1px solid var(--line);
  }

  .stats__item:first-child {
    border-left: none;
    padding-left: 0;
  }

  .stats__value {
    font-size: clamp(26px, 3.6vw, 48px);
    font-weight: 700;
    line-height: 1;
    color: var(--accent-ink);
  }

  .stats__label {
    font-size: 13px;
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats__item:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
  }

  /* ===== filters + work grid ===== */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filters__btn {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 10px 16px;
    border: 1px solid var(--line);
    color: var(--ink-2);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }

  .filters__btn:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .filters__btn.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .filters__count {
    opacity: 0.55;
    margin-left: 4px;
  }

  .filters__note {
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 14px;
    letter-spacing: 0.06em;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  /* ===== about + services ===== */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .about__copy {
    display: grid;
    gap: 20px;
    font-size: clamp(15.5px, 1.35vw, 18px);
    line-height: 1.75;
    color: var(--ink-2);
  }

  .about__copy strong {
    color: var(--ink);
  }

  .services {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .services__item {
    display: flex;
    gap: 20px;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
  }

  .services__num {
    font-size: 12px;
    color: var(--accent-ink);
    padding-top: 5px;
  }

  .services__title {
    font-size: 16.5px;
    font-weight: 700;
  }

  .services__text {
    font-size: 14px;
    color: var(--ink-2);
    margin-top: 3px;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* ===== team ===== */
  .team {
    display: grid;
    gap: 20px;
  }

  .member {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .member :global(.member__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-right: 1px solid var(--line-strong);
  }

  .member__body {
    padding: clamp(20px, 3vw, 32px);
  }

  .member__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
  }

  .member__role {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-ink);
    margin-top: 6px;
  }

  .member__bio {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-2);
    margin-top: 14px;
    max-width: 72ch;
  }

  .member__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  .member__tags span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border: 1px solid var(--line);
    color: var(--ink-2);
  }

  .member__links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 18px;
  }

  @media (max-width: 720px) {
    .member {
      grid-template-columns: 1fr;
    }

    .member :global(.member__photo) {
      max-height: 320px;
      border-right: none;
      border-bottom: 1px solid var(--line-strong);
    }
  }

  /* ===== publishers banner ===== */
  .pub-banner {
    background: var(--accent);
    color: var(--accent-contrast);
    border-block: 1px solid var(--line-strong);
  }

  .pub-banner__inner {
    padding-block: clamp(48px, 7vw, 88px);
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .pub-banner__title {
    font-size: clamp(24px, 4vw, 48px);
    max-width: 22ch;
  }

  .pub-banner__text {
    max-width: 52ch;
    font-size: 16px;
    opacity: 0.92;
  }

  .pub-banner__btn {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--line-strong);
  }

  /* ===== contact ===== */
  .contact {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .contact__email {
    font-size: clamp(18px, 3.6vw, 44px);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 3px solid var(--accent);
    padding-bottom: 6px;
    word-break: break-all;
    transition: color 0.15s ease;
  }

  .contact__email:hover {
    color: var(--accent-ink);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contact__note {
    font-size: 14px;
    color: var(--ink-3);
  }
</style>

<script>
  // ===== games filter =====
  function initFilters() {
    const grid = document.querySelector<HTMLElement>('[data-games-grid]');
    if (!grid) return;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const note = document.querySelector<HTMLElement>('[data-filter-note]');
    const cards = grid.querySelectorAll<HTMLElement>('[data-group]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        let shown = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.group === filter;
          card.toggleAttribute('hidden', !show);
          if (show) shown++;
        });
        if (note) note.textContent = `${shown} title${shown === 1 ? '' : 's'} shown`;
      });
    });
  }

  // ===== copy email =====
  function initCopyEmail() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.email ?? '');
          const prev = btn.textContent;
          btn.textContent = 'Copied ✓';
          setTimeout(() => (btn.textContent = prev), 2000);
        } catch {
          /* clipboard unavailable — the mailto link above still works */
        }
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initFilters();
    initCopyEmail();
  });
</script>
