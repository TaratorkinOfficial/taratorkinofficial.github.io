---
import { SITE } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="footer__mark display" aria-hidden="true">Taratorkin Official</p>

    <div class="footer__grid">
      <div>
        <p class="eyebrow">Studio</p>
        <ul>
          <li><a href={base + '#work'}>Work</a></li>
          <li><a href={base + '#studio'}>Studio</a></li>
          <li><a href={base + '#team'}>Team</a></li>
          <li><a href={base + 'pitch'}>For publishers</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href={base + 'privacy'}>Privacy policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="mono">© {year} {SITE.name} — all rights reserved</span>
      <span class="mono footer__loc">Made in Ukraine 🇺🇦</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(48px, 7vw, 88px) 32px;
    background: var(--surface);
  }

  .footer__mark {
    font-size: clamp(28px, 6.5vw, 84px);
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    opacity: 0.14;
    white-space: nowrap;
    overflow: hidden;
    margin-bottom: clamp(40px, 5vw, 64px);
    user-select: none;
  }

  /* Narrow screens: stack the wordmark instead of clipping mid-letter. */
  @media (max-width: 640px) {
    .footer__mark {
      white-space: normal;
      font-size: clamp(30px, 10.5vw, 56px);
      line-height: 1.05;
    }
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-bottom: 48px;
  }

  .footer__grid ul {
    list-style: none;
    margin-top: 16px;
    display: grid;
    gap: 10px;
  }

  .footer__grid a {
    text-decoration: none;
    font-size: 15px;
    color: var(--ink-2);
    transition: color 0.15s ease;
  }

  .footer__grid a:hover {
    color: var(--accent-ink);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    font-size: 12px;
    color: var(--ink-3);
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
