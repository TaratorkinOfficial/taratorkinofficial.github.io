---
import { Image } from 'astro:assets';
import type { Game } from '../data/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;

const links: { label: string; url: string }[] = [];
if (game.googlePlay) links.push({ label: 'Google Play', url: game.googlePlay });
if (game.appStore) links.push({ label: 'App Store', url: game.appStore });
if (game.external) links.push({ label: game.external.label, url: game.external.url });
---

<article class="card" data-group={game.group}>
  <div class="card__media">
    <Image
      src={game.cover}
      alt={`${game.title} — cover art`}
      width={640}
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 400px"
      loading="lazy"
    />
    {game.isNew && <span class="card__chip card__chip--new">New</span>}
    {game.badge && <span class="card__chip">{game.badge}</span>}
  </div>
  <div class="card__body">
    <h3 class="card__title">{game.title}</h3>
    <p class="card__desc">{game.description}</p>
    {
      links.length > 0 && (
        <p class="card__links">
          {links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    box-shadow: 5px 5px 0 var(--line-strong);
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 9px 9px 0 var(--line-strong);
  }

  .card__media {
    position: relative;
    border-bottom: 1px solid var(--line-strong);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__chip {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 9px;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .card__chip--new {
    background: var(--pop);
    border-color: var(--pop);
    color: #fff;
  }

  /* when both chips exist, stack them */
  .card__chip--new + .card__chip {
    top: 42px;
  }

  .card__body {
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;
  }

  .card__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    flex: 1;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 6px;
  }

  .card__links a {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .card__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
