---
import { SITE } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="footer__mark display" aria-hidden="true">Taratorkin Official</p>

    <div class="footer__grid">
      <div>
        <p class="eyebrow">Studio</p>
        <ul>
          <li><a href={base + '#work'}>Work</a></li>
          <li><a href={base + '#studio'}>Studio</a></li>
          <li><a href={base + 'pitch'}>For publishers</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Legal</p>
        <ul>
          <li><a href={base + 'privacy'}>Privacy policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {SITE.name} — all rights reserved</span>
      <span>Made in Ukraine 🇺🇦</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(48px, 7vw, 88px) 32px;
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 320px;
    background: radial-gradient(60% 100% at 50% 100%, var(--glow), transparent 75%);
    opacity: 0.35;
    pointer-events: none;
  }

  .footer__mark {
    font-size: clamp(30px, 7vw, 92px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, var(--text) 0%, transparent 130%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.16;
    margin-bottom: clamp(40px, 5vw, 64px);
    user-select: none;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-bottom: 48px;
    position: relative;
  }

  .footer__grid ul {
    list-style: none;
    margin-top: 16px;
    display: grid;
    gap: 10px;
  }

  .footer__grid a {
    text-decoration: none;
    font-size: 15px;
    color: var(--text-2);
    transition: color 0.15s ease;
  }

  .footer__grid a:hover {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    font-size: 13px;
    color: var(--text-3);
    position: relative;
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
