---
import { Image } from 'astro:assets';
import type { Game } from '../data/games';

interface Props {
  game: Game;
}

const { game } = Astro.props;

const links: { label: string; url: string }[] = [];
if (game.googlePlay) links.push({ label: 'Google Play', url: game.googlePlay });
if (game.appStore) links.push({ label: 'App Store', url: game.appStore });
if (game.external) links.push({ label: game.external.label, url: game.external.url });
---

<article class="card" data-group={game.group} data-tilt>
  <!-- ambilight: blurred copy of the art glows behind the card -->
  <div class="card__ambilight" aria-hidden="true">
    <Image src={game.cover} alt="" width={320} loading="lazy" />
  </div>

  <div class="card__inner glass">
    <div class="card__media">
      <Image
        src={game.cover}
        alt={`${game.title} — cover art`}
        width={640}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 400px"
        loading="lazy"
      />
      {game.isNew && <span class="card__chip card__chip--new">New</span>}
      {game.badge && <span class="card__chip">{game.badge}</span>}
      <span class="card__specular" aria-hidden="true"></span>
    </div>
    <div class="card__body">
      <h3 class="card__title">{game.title}</h3>
      <p class="card__desc">{game.description}</p>
      {
        links.length > 0 && (
          <p class="card__links">
            {links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener">
                {l.label} ↗
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    perspective: 900px;
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
  }

  .card__ambilight {
    position: absolute;
    inset: 6%;
    z-index: 0;
    filter: blur(32px) saturate(1.5);
    opacity: 0.4;
    transform: translateZ(0);
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .card__ambilight :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .card:hover .card__ambilight {
    opacity: 0.75;
  }

  html[data-theme='light'] .card__ambilight {
    opacity: 0.3;
  }

  html[data-theme='light'] .card:hover .card__ambilight {
    opacity: 0.55;
  }

  .card__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
    transition: transform 0.25s var(--ease);
    will-change: transform;
  }

  .card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .card__media > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .card:hover .card__media > :global(img) {
    transform: scale(1.045);
  }

  /* specular highlight that follows the cursor */
  .card__specular {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx) var(--my),
      rgba(255, 255, 255, 0.16),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .card:hover .card__specular {
    opacity: 1;
  }

  .card__chip {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    /* no backdrop-filter: the chip lives inside the tilting (animated) card,
       backdrop sampling there shimmers on Windows — a denser fill reads the same */
    background: rgba(10, 12, 18, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .card__chip--new {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 130%);
    border-color: transparent;
  }

  /* when both chips exist, stack them */
  .card__chip--new + .card__chip {
    top: 46px;
  }

  .card__body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 16.5px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .card__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-2);
    flex: 1;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 6px;
  }

  .card__links a {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: none;
  }

  .card__links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
