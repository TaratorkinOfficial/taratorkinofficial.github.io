---
import { Image } from 'astro:assets';
import type { Game } from '../data/games';
import playIcon from '../assets/store/playstore.svg';
import appleIcon from '../assets/store/appstore.svg';

interface Props {
  game: Game;
}

const { game } = Astro.props;

const stores: { label: string; url: string; icon: string }[] = [];
if (game.googlePlay) stores.push({ label: 'Google Play', url: game.googlePlay, icon: playIcon.src });
if (game.appStore) stores.push({ label: 'App Store', url: game.appStore, icon: appleIcon.src });
---

<article class="card" data-group={game.group} data-tilt>
  <!-- ambilight: blurred copy of the art glows behind the card -->
  <div class="card__ambilight" aria-hidden="true">
    <Image src={game.cover} alt="" width={320} loading="lazy" />
  </div>

  <div class="card__inner glass">
    <div class="card__media">
      <Image
        src={game.cover}
        alt={`${game.title} — cover art`}
        width={640}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 400px"
        loading="lazy"
      />
      <span class="card__scrim" aria-hidden="true"></span>
      <span class="card__specular" aria-hidden="true"></span>

      {game.isNew && <span class="card__chip card__chip--new">New</span>}
      {game.badge && <span class="card__chip">{game.badge}</span>}

      <div class="card__overlay">
        <h3 class="card__title">{game.title}</h3>
        <div class="card__reveal">
          <div class="card__reveal-inner">
            <p class="card__desc">{game.description}</p>
            {
              (stores.length > 0 || game.external) && (
                <p class="card__stores">
                  {stores.map((s) => (
                    <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                      <img src={s.icon} alt={s.label} width="40" height="40" loading="lazy" />
                    </a>
                  ))}
                  {game.external && (
                    <a href={game.external.url} target="_blank" rel="noopener" class="card__ext">
                      {game.external.label} ↗
                    </a>
                  )}
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    perspective: 900px;
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
  }

  .card__ambilight {
    position: absolute;
    inset: 6%;
    z-index: 0;
    filter: blur(32px) saturate(1.5);
    opacity: 0.4;
    transform: translateZ(0);
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .card__ambilight :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .card:hover .card__ambilight {
    opacity: 0.75;
  }

  html[data-theme='light'] .card__ambilight {
    opacity: 0.3;
  }

  html[data-theme='light'] .card:hover .card__ambilight {
    opacity: 0.55;
  }

  .card__inner {
    position: relative;
    z-index: 1;
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
    transition: transform 0.25s var(--ease);
    will-change: transform;
  }

  /* the media IS the card now — square, full-bleed art with an overlay */
  .card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .card__media > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .card:hover .card__media > :global(img) {
    transform: scale(1.05);
  }

  /* darkening scrim: subtle base for the always-on title, deeper on hover so the
     revealed description stays legible over any art */
  .card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(0, 0, 0, 0.55) 72%,
      rgba(0, 0, 0, 0.9) 100%
    );
    transition: background 0.4s ease;
    pointer-events: none;
  }

  .card:hover .card__scrim {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.5) 45%,
      rgba(0, 0, 0, 0.92) 100%
    );
  }

  /* specular highlight that follows the cursor */
  .card__specular {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      280px circle at var(--mx) var(--my),
      rgba(255, 255, 255, 0.16),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .card:hover .card__specular {
    opacity: 1;
  }

  .card__chip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    /* no backdrop-filter: the chip lives inside the tilting (animated) card,
       backdrop sampling there shimmers on Windows — a denser fill reads the same */
    background: rgba(10, 12, 18, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .card__chip--new {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 130%);
    border-color: transparent;
  }

  /* when both chips exist, stack them */
  .card__chip--new + .card__chip {
    top: 46px;
  }

  /* overlay: title pinned to the bottom, details slide up on hover */
  .card__overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    /* generous bottom/side padding so a store icon lifting + scaling on hover
       never gets clipped by the card's rounded corner */
    padding: 16px 22px 22px;
    color: #fff;
    pointer-events: none;
  }

  .card__overlay a {
    pointer-events: auto;
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.75);
  }

  /* collapsed by default, expands to natural height on hover */
  .card__reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s var(--ease),
      opacity 0.35s ease;
  }

  .card__reveal-inner {
    min-height: 0;
    overflow: hidden;
  }

  .card:hover .card__reveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .card__desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 8px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .card__stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .card__stores img {
    width: 40px;
    height: 40px;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
    transition: transform 0.2s var(--spring);
  }

  .card__stores a:hover img {
    transform: translateY(-3px) scale(1.06);
  }

  .card__ext {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.18);
    padding: 8px 14px;
    border-radius: 8px;
  }

  .card__ext:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  /* touch / no-hover: reveal details permanently, they can't hover to see them */
  @media (hover: none) {
    .card__reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .card__scrim {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.15) 0%,
        rgba(0, 0, 0, 0.5) 45%,
        rgba(0, 0, 0, 0.92) 100%
      );
    }
  }
</style>
