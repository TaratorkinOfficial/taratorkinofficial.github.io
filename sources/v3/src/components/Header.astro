---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.webp';
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

/** Anchors resolve against the home page so they work from any route. */
const nav = [
  { label: 'Work', href: base + '#work' },
  { label: 'Studio', href: base + '#studio' },
  { label: 'Contact', href: base + '#contact' },
];

/* On the pitch page itself, "For publishers" would link to the page the
   reader is already on — swap the CTA for a direct contact instead. */
const onPitch = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/$/, '')
  .endsWith('/pitch');
---

<header class="header" data-header>
  <div class="header__pill">
    <a href={base} class="wordmark" aria-label="Taratorkin Official — home">
      <Image src={logo} alt="" width={64} densities={[1, 2]} class="wordmark__logo" />
      <span class="wordmark__text">Taratorkin&nbsp;Official</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      {
        onPitch ? (
          <a href={`mailto:${SITE.email}`} class="nav__extra">Email us</a>
        ) : (
          <a href={base + 'pitch'} class="nav__extra">For publishers</a>
        )
      }
    </nav>

    <div class="header__actions">
      {
        onPitch ? (
          <a href={`mailto:${SITE.email}`} class="nav__pitch">Email us</a>
        ) : (
          <a href={base + 'pitch'} class="nav__pitch">For publishers</a>
        )
      }
      <ThemeToggle />
      <button
        type="button"
        class="menu-btn"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="menu-btn__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 14px;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    height: 0; /* pill floats without reserving layout height beyond itself */
  }

  .header__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(14px, 2.5vw, 36px);
    width: min(var(--container), 100%);
    height: 58px;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    /* Chrome is invisible at the top of the page — the pill floats cleanly over
       the hero. Background, border and blur fade in only once the page scrolls,
       so there is never a flat "strip" sitting over the coloured hero. */
    border: 1px solid transparent;
    background: transparent;
    box-shadow: 0 0 0 0 transparent;
    transform: translateZ(0);
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      backdrop-filter 0.3s var(--ease);
  }

  .header[data-scrolled] .header__pill {
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
    border-color: var(--line-2);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .wordmark :global(.wordmark__logo) {
    width: 32px;
    height: auto;
    border-radius: 9px;
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(4px, 1.4vw, 12px);
  }

  .nav a {
    position: relative;
    font-size: 14px;
    font-weight: 550;
    text-decoration: none;
    color: var(--text-2);
    padding: 8px 14px;
    border-radius: 999px;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav__pitch {
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    color: var(--accent-contrast);
    background: linear-gradient(135deg, var(--btn-1) 0%, var(--btn-2) 130%);
    padding: 10px 18px;
    border-radius: 999px;
    box-shadow: 0 8px 22px -8px var(--glow);
    transition:
      transform 0.2s var(--spring),
      box-shadow 0.2s ease;
  }

  .nav__pitch:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 30px -8px var(--glow);
  }

  /* the CTA lives in the header bar on wide screens; the dropdown carries it on phones */
  .nav__extra {
    display: none;
  }

  .menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    align-items: center;
    justify-content: center;
  }

  .menu-btn__bars,
  .menu-btn__bars::before,
  .menu-btn__bars::after {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s ease;
  }

  .menu-btn__bars {
    position: relative;
  }

  .menu-btn__bars::before,
  .menu-btn__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-btn__bars::before {
    top: -5px;
  }

  .menu-btn__bars::after {
    top: 5px;
  }

  .header[data-menu-open] .menu-btn__bars {
    background: transparent;
  }

  .header[data-menu-open] .menu-btn__bars::before {
    transform: translateY(5px) rotate(45deg);
  }

  .header[data-menu-open] .menu-btn__bars::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .header__pill {
      position: relative;
    }

    .menu-btn {
      display: inline-flex;
    }

    /* dropdown panel under the pill */
    .nav {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 8px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line-2);
      background: color-mix(in srgb, var(--bg-2) 94%, transparent);
      box-shadow: var(--shadow);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity 0.2s ease,
        transform 0.25s var(--ease),
        visibility 0s linear 0.25s;
    }

    .header[data-menu-open] .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0.25s var(--ease);
    }

    /* the bar must be solid while the menu is open, even at the top of the page */
    .header[data-menu-open] .header__pill {
      background: color-mix(in srgb, var(--bg-2) 94%, transparent);
      border-color: var(--line-2);
    }

    .nav a {
      font-size: 16px;
      color: var(--text);
      padding: 14px 16px;
      border-radius: 14px;
    }

    .nav a::after {
      display: none;
    }

    .nav a:hover {
      background: var(--glass-2);
    }
  }

  @media (max-width: 480px) {
    .header__pill {
      padding-left: 14px;
    }

    .header__actions .nav__pitch {
      display: none;
    }

    .nav__extra {
      display: block;
      color: var(--accent-ink) !important;
      font-weight: 650 !important;
    }
  }
</style>

<script>
  // Fade the header chrome in only after the page leaves the top, so the pill
  // floats invisibly over the hero and never reads as a flat strip.
  function initHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header || header.hasAttribute('data-header-ready')) return;
    header.setAttribute('data-header-ready', '');

    const onScroll = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Mobile menu: one toggle button, closes on link tap, Escape or outside tap.
  function initMenu() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const btn = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!header || !btn || btn.hasAttribute('data-menu-ready')) return;
    btn.setAttribute('data-menu-ready', '');

    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    btn.addEventListener('click', () => setOpen(!header.hasAttribute('data-menu-open')));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-menu-open')) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (header.hasAttribute('data-menu-open') && !header.contains(e.target as Node)) setOpen(false);
    });
  }

  function initHeader() {
    initHeaderScroll();
    initMenu();
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
