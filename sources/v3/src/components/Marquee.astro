---
import { Image } from 'astro:assets';
import { GAMES } from '../data/games';

/**
 * Single-row cover wall drifting sideways. Pure CSS animation,
 * horizontal scroll under reduced motion.
 */
const rowA = GAMES.filter((g) => g.group !== 'experience').map((g) => g.cover);
---

<div class="wall" aria-hidden="true">
  <div class="wall__row wall__row--front">
    <div class="wall__track">
      {
        [0, 1].map(() => (
          <div class="wall__group">
            {rowA.map((cover) => (
              <Image src={cover} alt="" width={260} height={260} class="wall__img" loading="eager" />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .wall {
    position: relative;
    display: grid;
    gap: 18px;
    padding-block: 10px;
    overflow: hidden;
    /* fade the edges out */
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .wall__row {
    overflow: hidden;
  }

  .wall__track {
    display: flex;
    width: max-content;
    animation: drift 52s linear infinite;
  }

  .wall:hover .wall__track {
    animation-play-state: paused;
  }

  .wall__group {
    display: flex;
    gap: 18px;
    padding-right: 18px;
  }

  .wall :global(.wall__img) {
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    flex-shrink: 0;
  }

  .wall__row--front :global(.wall__img) {
    width: clamp(120px, 15vw, 190px);
    height: clamp(120px, 15vw, 190px);
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.55);
  }

  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__row {
      overflow-x: auto;
    }

    .wall__track {
      animation: none;
    }

  }
</style>
