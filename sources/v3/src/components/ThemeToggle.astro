---
/**
 * Theme toggle — delegation-based so it survives View Transitions swaps.
 * The actual theme boot script lives inline in Base.astro <head> to avoid FOUC.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-live="polite">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  </svg>
  <span class="theme-toggle__label" data-theme-label>Light</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--text-2);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .theme-toggle:hover {
    border-color: var(--line-2);
    color: var(--text);
  }

  /* the icon shows the theme you'll switch TO, matching the text label */
  .theme-toggle__icon {
    flex-shrink: 0;
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  :global(html[data-theme='light']) .theme-toggle__icon--sun {
    display: none;
  }

  :global(html[data-theme='light']) .theme-toggle__icon--moon {
    display: block;
  }

  @media (max-width: 480px) {
    .theme-toggle {
      width: 40px;
      height: 40px;
      padding: 0;
      justify-content: center;
    }

    .theme-toggle__label {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'tt-theme';

  function currentTheme(): string {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function syncLabels() {
    const next = currentTheme() === 'dark' ? 'Light' : 'Dark';
    document
      .querySelectorAll<HTMLElement>('[data-theme-label]')
      .forEach((el) => (el.textContent = next));
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) =>
        btn.setAttribute('aria-label', `Switch to ${next.toLowerCase()} theme`),
      );
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
    if (!btn) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem(KEY, next);
    syncLabels();
  });

  document.addEventListener('astro:page-load', syncLabels);
</script>
