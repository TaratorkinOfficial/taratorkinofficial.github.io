---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';

import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CF_ANALYTICS_TOKEN } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  noindex?: boolean;
  /** Skip the shared site chrome (used by the internal roadmap page). */
  bare?: boolean;
  /** Extra JSON-LD structured data, serialized as-is. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  path,
  lang = 'en',
  noindex = false,
  bare = false,
  jsonLd,
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

/* Sub-path deployments (BASE_PATH set) are mirrors — never index them. */
const effectiveNoindex = noindex || import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0c12" />

    <SEO {title} {description} {path} noindex={effectiveNoindex} />

    <link rel="icon" href={base + 'favicon.ico'} sizes="32x32" />
    <link rel="icon" href={base + 'icons/favicon-32.png'} type="image/png" sizes="32x32" />
    <link rel="icon" href={base + 'icons/favicon-192.png'} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={base + 'icons/apple-touch-icon.png'} />
    <link rel="manifest" href={base + 'icons/site.webmanifest'} />
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Theme boot: dark by default, runs before paint, survives VT swaps. -->
    <script is:inline>
      (function () {
        const apply = () => {
          let theme = 'dark';
          try {
            const saved = localStorage.getItem('tt-theme');
            if (saved === 'light' || saved === 'dark') theme = saved;
            else if (matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
          } catch {}
          document.documentElement.dataset.theme = theme;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />

    {
      /* production builds only — local dev sessions must not pollute the stats */
      CF_ANALYTICS_TOKEN && import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <!-- Reveal-on-scroll: respects prefers-reduced-motion via CSS fallback. -->
    <script>
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>

    <!-- 3D tilt + specular highlight for [data-tilt] cards (pointer devices only). -->
    <script>
      function initTilt() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;

        const MAX = 7; // degrees

        document.querySelectorAll<HTMLElement>('[data-tilt]:not([data-tilt-ready])').forEach((el) => {
          el.setAttribute('data-tilt-ready', '');

          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            el.style.setProperty('--mx', `${px * 100}%`);
            el.style.setProperty('--my', `${py * 100}%`);
            el.style.setProperty('--rx', `${(0.5 - py) * MAX}deg`);
            el.style.setProperty('--ry', `${(px - 0.5) * MAX}deg`);
          });

          el.addEventListener('pointerleave', () => {
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
          });
        });
      }

      document.addEventListener('astro:page-load', initTilt);
    </script>
  </body>
</html>
