---
import Base from '../layouts/Base.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Base
  title="404 — Taratorkin Official"
  description="Page not found."
  path="/404"
  noindex
>
  <section class="nf container">
    <p class="nf__code display" aria-hidden="true">404</p>
    <h1 class="nf__title">Level not found.</h1>
    <p class="nf__text">This screen doesn't exist — but our games do.</p>
    <div class="nf__actions">
      <a href={base} class="btn btn--accent">← Back to home</a>
      <a href={base + '#work'} class="btn">See the games</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-block: clamp(64px, 10vw, 140px);
  }

  .nf__code {
    position: relative;
    font-size: clamp(80px, 18vw, 220px);
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: nf-float 6s ease-in-out infinite;
  }

  .nf__code::before {
    content: '';
    position: absolute;
    inset: -30% -20%;
    background: radial-gradient(closest-side, var(--glow), transparent 72%);
    opacity: 0.7;
    z-index: -1;
    pointer-events: none;
  }

  @keyframes nf-float {
    0%,
    100% {
      transform: translateY(6px);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  .nf__title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.4vw, 36px);
    margin-top: 20px;
  }

  .nf__text {
    color: var(--text-2);
    margin-top: 10px;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
