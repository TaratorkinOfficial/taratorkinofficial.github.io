---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import GameCard from '../components/GameCard.astro';
import { GAMES, GROUPS, type GameGroup } from '../data/games';
import { TEAM } from '../data/team';
import { SITE, STATS } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const SERVICES = [
  { title: 'Rapid prototyping', text: 'Quick, playable prototypes that validate core loops' },
  { title: 'Production & polish', text: 'Robust Unity pipelines with great art direction' },
  { title: 'Live-ops & support', text: 'A/B testing, events, retention optimization' },
  { title: 'Monetization', text: 'IAP economy, rewarded ads, fair player experience' },
  { title: 'Data-driven development', text: 'Analytics-informed decisions for retention & growth' },
  { title: 'Full-cycle development', text: 'From concept to launch with live-ops support' },
];

const groupOrder: GameGroup[] = ['collab', 'studio', 'experience'];
const groupCounts = Object.fromEntries(
  groupOrder.map((g) => [g, GAMES.filter((x) => x.group === g).length]),
) as Record<GameGroup, number>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/icons/favicon-512.png`,
  description: SITE.description,
  foundingDate: String(SITE.foundingYear),
  email: SITE.email,
  sameAs: [SITE.linkedin],
};
---

<Base
  title="Taratorkin Official — independent mobile games studio"
  description="Independent mobile games studio crafting polished, retention-driven hyper, hybrid, and casual titles since 2020. 19 games shipped, 10M+ downloads."
  path="/"
  jsonLd={jsonLd}
>
  <!-- ===== HERO ===== -->
  <section class="hero" data-glow>
    <div class="hero__spotlight" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="hero__eyebrow eyebrow eyebrow--accent">
        <span class="hero__dot"></span> Independent games studio · est. {SITE.foundingYear}
      </p>
      <h1 class="hero__title display">
        We make mobile games<br class="hero__br" /> people come <em>back</em> to.
      </h1>
      <p class="hero__lede">
        Hyper, hybrid & casual titles — designed, built, and operated by a four-person
        full-stack team. Easy to learn, hard to put down.
      </p>
      <div class="hero__actions">
        <a href="#work" class="btn btn--accent">See the work</a>
        <a href={base + 'pitch'} class="btn">Publisher pitch</a>
      </div>

      <dl class="hero__stats" aria-label="Studio in numbers">
        {
          STATS.map((s) => (
            <div class="hero__stat">
              <dt class="hero__stat-value display">
                <span data-countup={s.value}>{s.value}</span>{s.suffix}
              </dt>
              <dd class="hero__stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero__wall">
      <Marquee />
    </div>
  </section>

  <!-- ===== WORK ===== -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <span class="idx">01 · Portfolio</span>
        <h2 class="section-title">The <em>work</em></h2>
      </div>

      <div class="filters" role="group" aria-label="Filter games by group">
        <button type="button" class="filters__btn is-active" data-filter="all" aria-pressed="true">
          All <span class="filters__count">{GAMES.length}</span>
        </button>
        {
          groupOrder.map((g) => (
            <button type="button" class="filters__btn" data-filter={g} aria-pressed="false">
              {GROUPS[g].label} <span class="filters__count">{groupCounts[g]}</span>
            </button>
          ))
        }
      </div>
      <p class="filters__note" data-filter-note>
        {GAMES.length} titles · collaborations, studio releases & prior team credits
      </p>

      <div class="work-grid" data-games-grid>
        {GAMES.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <!-- ===== STUDIO / ABOUT ===== -->
  <section class="section" id="studio">
    <div class="container">
      <div class="section-head">
        <span class="idx">02 · Studio</span>
        <h2 class="section-title">Built like a <em>bigger</em> studio</h2>
      </div>

      <div class="about">
        <div class="about__copy glass">
          <p>
            <strong>Taratorkin Official</strong> is an independent mobile games studio with a
            clear focus: build polished, retention-driven experiences that players return to.
            Since 2020 our core team has been designing, prototyping and shipping titles across
            the hyper, hybrid, and casual space.
          </p>
          <p>
            We combine fast iteration with production discipline to deliver both hits and
            steady-grossing live games. Our approach blends creative design, lean engineering
            and data-informed live-ops.
          </p>
          <p>
            <strong>AI is part of our pipeline.</strong> We use it to multiply creative variants,
            accelerate balance passes, and rapidly iterate on UA hooks — but every AI-generated
            output is benchmarked against a human-made baseline before shipping. Speed never
            comes at the cost of quality, and a compact team operates at the throughput of a
            much larger studio.
          </p>
          <p>
            From rapid prototyping to full production and long-term live-ops, we cover the
            entire lifecycle of a mobile game. Our toolbox spans A/B testing, event-driven
            content, retention & LTV optimization, IAP economy design, and rewarded-ad
            mediation — across hyper, hybrid, and casual genres, all under one roof.
          </p>
        </div>

        <ol class="services">
          {
            SERVICES.map((s, i) => (
              <li class="services__item glass reveal">
                <span class="services__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="services__title">{s.title}</h3>
                  <p class="services__text">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- compact team strip — merged into the studio section -->
      <div class="team-strip">
        <p class="team-strip__head eyebrow">The four people behind every title</p>
        <div class="team-strip__grid">
          {
            TEAM.map((m) => (
              <article class="tmember glass reveal">
                <Image
                  src={m.photo}
                  alt={`Portrait of ${m.name}`}
                  width={220}
                  widths={[110, 220]}
                  sizes="104px"
                  class="tmember__photo"
                  loading="lazy"
                />
                <div class="tmember__body">
                  <h3 class="tmember__name">{m.name.split(' ')[0]}</h3>
                  <p class="tmember__role">{m.role}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PUBLISHERS BANNER ===== -->
  <section class="container">
    <div class="pub-banner reveal">
      <div class="pub-banner__glow" aria-hidden="true"></div>
      <h2 class="pub-banner__title display">Publishing or scouting prototypes?</h2>
      <p class="pub-banner__text">
        4-week sprints, dual-platform builds, UA creatives included. See how we work with
        publishers.
      </p>
      <a href={base + 'pitch'} class="btn pub-banner__btn">Read the pitch ↗</a>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="section-head">
        <span class="idx">03 · Contact</span>
        <h2 class="section-title">Let's <em>talk</em></h2>
      </div>

      <div class="contact">
        <a href={`mailto:${SITE.email}`} class="contact__email display grad-text">{SITE.email}</a>
        <div class="contact__actions">
          <button type="button" class="btn" data-copy-email data-email={SITE.email}>
            Copy address
          </button>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="btn">LinkedIn ↗</a>
        </div>
        <p class="contact__note">
          Partnerships, publishing, or listing your game — we answer every serious email.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== hero ===== */
  .hero {
    position: relative;
    /* fill the viewport like the legacy hero, so the ambient background and
       spotlight span a full screen; text centers in the space above the wall,
       the icon wall sits at the bottom edge */
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 64px));
    padding-bottom: clamp(40px, 6vw, 80px);
    overflow: hidden;
  }

  /* cursor-following glow */
  .hero__spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      520px circle at var(--gx, 30%) var(--gy, 20%),
      var(--glow),
      transparent 65%
    );
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    /* grow to fill the space above the wall and center the copy within it */
    flex: 1 1 auto;
    align-content: center;
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--glass);
    margin-bottom: 30px;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .hero__title {
    font-size: clamp(36px, 6.4vw, 82px);
    line-height: 1.05;
    max-width: 22ch;
  }

  .hero__title em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__lede {
    max-width: 54ch;
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--text-2);
    margin-top: 24px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  .hero__wall {
    margin-top: clamp(48px, 7vw, 88px);
  }

  @media (max-width: 720px) {
    .hero__br {
      display: none;
    }
  }

  /* ===== hero stats (inline row inside the hero) ===== */
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(26px, 6vw, 72px);
    margin-top: clamp(36px, 5vw, 52px);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .hero__stat-value {
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1;
    background: linear-gradient(100deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }

  .hero__stat-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-2);
  }

  /* ===== filters + work grid ===== */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filters__btn {
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--text-2);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .filters__btn:hover {
    border-color: var(--line-2);
    color: var(--text);
  }

  .filters__btn.is-active {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 130%);
    border-color: transparent;
    color: var(--accent-contrast);
    box-shadow: 0 8px 24px -8px var(--glow);
  }

  .filters__count {
    opacity: 0.6;
    margin-left: 4px;
    font-variant-numeric: tabular-nums;
  }

  .filters__note {
    font-size: 13px;
    color: var(--text-3);
    margin-top: 14px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
    margin-top: 32px;
  }

  /* ===== about + services ===== */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 3.5vw, 48px);
    align-items: start;
  }

  .about__copy {
    display: grid;
    gap: 18px;
    padding: clamp(26px, 3.4vw, 44px);
    font-size: clamp(15.5px, 1.3vw, 17.5px);
    line-height: 1.75;
    color: var(--text-2);
  }

  .about__copy strong {
    color: var(--text);
  }

  .services {
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .services__item {
    display: flex;
    gap: 18px;
    padding: 18px 22px;
    transition:
      transform 0.25s var(--spring),
      border-color 0.2s ease;
  }

  .services__item:hover {
    transform: translateX(6px);
    border-color: var(--line-2);
  }

  .services__num {
    font-size: 13px;
    font-weight: 650;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  .services__title {
    font-size: 16px;
    font-weight: 650;
  }

  .services__text {
    font-size: 14px;
    color: var(--text-2);
    margin-top: 3px;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* ===== team strip (merged into studio) ===== */
  .team-strip {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: clamp(24px, 3.5vw, 40px);
    border-top: 1px solid var(--line);
  }

  .team-strip__head {
    margin-bottom: 18px;
  }

  .team-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .tmember {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(24px, 3vw, 34px) 18px;
    transition:
      transform 0.25s var(--spring),
      border-color 0.2s ease;
  }

  .tmember:hover {
    transform: translateY(-4px);
    border-color: var(--line-2);
  }

  .tmember :global(.tmember__photo) {
    width: clamp(88px, 9vw, 104px);
    height: clamp(88px, 9vw, 104px);
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line-2);
  }

  .tmember__body {
    display: grid;
    gap: 6px;
  }

  .tmember__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 650;
    line-height: 1.25;
  }

  .tmember__role {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent-ink);
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .team-strip__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ===== publishers banner ===== */
  .pub-banner {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 26%, var(--bg-2)),
      color-mix(in srgb, var(--accent-2) 20%, var(--bg-2)) 100%
    );
    padding: clamp(40px, 6vw, 80px);
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .pub-banner__glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, var(--glow), transparent 70%);
    pointer-events: none;
  }

  .pub-banner__title {
    font-size: clamp(26px, 4vw, 46px);
    max-width: 22ch;
    position: relative;
  }

  .pub-banner__text {
    max-width: 52ch;
    font-size: 16px;
    color: var(--text-2);
    position: relative;
  }

  .pub-banner__btn {
    position: relative;
  }

  /* ===== contact ===== */
  .contact {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .contact__email {
    font-size: clamp(20px, 3.8vw, 48px);
    text-decoration: none;
    word-break: break-all;
    transition: opacity 0.15s ease;
  }

  .contact__email:hover {
    opacity: 0.8;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contact__note {
    font-size: 14px;
    color: var(--text-3);
  }
</style>

<script>
  // ===== hero cursor glow =====
  function initHeroGlow() {
    const hero = document.querySelector<HTMLElement>('[data-glow]');
    if (!hero || hero.hasAttribute('data-glow-ready')) return;
    hero.setAttribute('data-glow-ready', '');
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--gx', `${((e.clientX - r.left) / r.width) * 100}%`);
      hero.style.setProperty('--gy', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  }

  // ===== count-up stats =====
  function initCountUp() {
    const els = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-counted])');
    if (!els.length) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.setAttribute('data-counted', '');
          io.unobserve(el);

          const target = parseInt(el.dataset.countup ?? '0', 10);
          if (reduce || !Number.isFinite(target)) {
            el.textContent = String(target);
            continue;
          }
          const dur = 1100;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.4 },
    );
    els.forEach((el) => io.observe(el));
  }

  // ===== games filter =====
  function initFilters() {
    const grid = document.querySelector<HTMLElement>('[data-games-grid]');
    if (!grid || grid.hasAttribute('data-filters-ready')) return;
    grid.setAttribute('data-filters-ready', '');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const note = document.querySelector<HTMLElement>('[data-filter-note]');
    const cards = grid.querySelectorAll<HTMLElement>('[data-group]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter!;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        let shown = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.group === filter;
          card.toggleAttribute('hidden', !show);
          if (show) shown++;
        });
        if (note) note.textContent = `${shown} title${shown === 1 ? '' : 's'} shown`;
      });
    });
  }

  // ===== copy email =====
  function legacyCopy(text: string): boolean {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {}
    ta.remove();
    return ok;
  }

  function initCopyEmail() {
    document
      .querySelectorAll<HTMLButtonElement>('[data-copy-email]:not([data-copy-ready])')
      .forEach((btn) => {
        btn.setAttribute('data-copy-ready', '');
        initCopyButton(btn);
      });
  }

  function initCopyButton(btn: HTMLButtonElement) {
    btn.addEventListener('click', async () => {
        const email = btn.dataset.email ?? '';
        const prev = btn.textContent;
        let ok = false;
        try {
          await navigator.clipboard.writeText(email);
          ok = true;
        } catch {
          ok = legacyCopy(email);
        }

        if (ok) {
          btn.textContent = 'Copied ✓';
        } else {
          // last resort: select the big email link so the user can Ctrl+C it
          const emailEl = document.querySelector('.contact__email');
          if (emailEl) {
            const range = document.createRange();
            range.selectNodeContents(emailEl);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
          }
          btn.textContent = 'Press Ctrl+C';
        }
        setTimeout(() => (btn.textContent = prev), 2200);
    });
  }

  function initAll() {
    initHeroGlow();
    initCountUp();
    initFilters();
    initCopyEmail();
  }

  // Run immediately too: on a first client-side (View Transitions) visit this
  // module can finish loading AFTER astro:page-load has already fired.
  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
