  }

  @media (max-width: 900px) {
    .rules {
      grid-template-columns: 1fr;
    }
  }

  .rm-footer {
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
