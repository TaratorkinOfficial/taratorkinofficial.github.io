---
/**
 * Internal sprint roadmap. Bilingual: RU is server-rendered default,
 * EN applied client-side via data-ru/data-en attributes (single DOM, no dupes).
 * noindex + excluded from sitemap + disallowed in robots.txt.
 */
import Base from '../layouts/Base.astro';
import {
  UI,
  WEEKS,
  DAYS,
  ROWS,
  CHECKPOINTS,
  FLOW,
  RULES,
  LEGEND,
  type Lang,
} from '../data/roadmap';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const t = (key: string, lang: Lang = 'ru') => UI[key]?.[lang] ?? '';

const cpByDay = new Map(CHECKPOINTS.map((c) => [c.day, c]));
const year = new Date().getFullYear();
---

<Base
  title="Дорожная карта · Taratorkin Official"
  description="Внутренняя методика спринта студии Taratorkin Official."
  path="/roadmap"
  lang="ru"
  noindex
  bare
>
  <div class="rm container">
    <!-- hero -->
    <header class="rm-hero">
      <div>
        <p class="eyebrow eyebrow--accent" data-ru={t('eyebrow', 'ru')} data-en={t('eyebrow', 'en')}>
          {t('eyebrow', 'ru')}
        </p>
        <h1 class="rm-hero__title display" data-ru={t('title', 'ru')} data-en={t('title', 'en')}>
          {t('title', 'ru')}
        </h1>
        <p class="rm-hero__lede" data-ru={t('lede', 'ru')} data-en={t('lede', 'en')}>
          {t('lede', 'ru')}
        </p>
      </div>
      <div class="rm-hero__side">
        <div class="lang-toggle" role="group" aria-label="Язык / Language">
          <button type="button" data-lang="ru" class="is-active" aria-pressed="true">RU</button>
          <button type="button" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <a href={base} class="rm-home">← taratorkinofficial.github.io</a>
        <dl class="rm-stats">
          <div><dd class="mono">20</dd><dt data-ru={t('statDays','ru')} data-en={t('statDays','en')}>{t('statDays','ru')}</dt></div>
          <div><dd class="mono">4</dd><dt data-ru={t('statWeeks','ru')} data-en={t('statWeeks','en')}>{t('statWeeks','ru')}</dt></div>
          <div><dd class="mono">6</dd><dt data-ru={t('statCheckpoints','ru')} data-en={t('statCheckpoints','en')}>{t('statCheckpoints','ru')}</dt></div>
        </dl>
      </div>
    </header>

    <!-- timeline board -->
    <p class="rm-scroll-hint" data-ru={t('scrollHint','ru')} data-en={t('scrollHint','en')}>
      {t('scrollHint', 'ru')}
    </p>
    <div class="board-scroll">
      <div class="board">
        <!-- week tabs -->
        <div class="board__weeks">
          <div></div>
          {
            WEEKS.map((w) => (
              <div class="wk" style={`--wc: var(${w.colorVar})`}>
                <span class="wk__num" data-ru={w.num.ru} data-en={w.num.en}>{w.num.ru}</span>
                <span class="wk__title" data-ru={w.title.ru} data-en={w.title.en}>{w.title.ru}</span>
              </div>
            ))
          }
        </div>

        <!-- day headers -->
        <div class="board__days">
          <div></div>
          {
            DAYS.ru.map(([wd, num], i) => (
              <div class:list={['day', { 'day--wb': i > 0 && i % 5 === 0 }]}>
                <span data-ru={wd} data-en={DAYS.en[i][0]}>{wd}</span>
                <span class="day__num mono">{num}</span>
              </div>
            ))
          }
        </div>

        <!-- calendar rows -->
        <div class="board__cal">
          {
            ROWS.map((row) => (
              <>
                <div class="role" data-role={row.key}>
                  <span class="role__tag">
                    {row.tag} · <span data-ru={t('roleWord','ru')} data-en={t('roleWord','en')}>{t('roleWord','ru')}</span>
                  </span>
                  <span class="role__name" data-ru={row.name.ru} data-en={row.name.en}>{row.name.ru}</span>
                  <span class="role__sub" data-ru={row.sub.ru} data-en={row.sub.en}>{row.sub.ru}</span>
                </div>
                {row.items.map((it) => (
                  <div
                    class:list={['cell', `cell--${it.type}`, { 'cell--strong': it.strong }]}
                    style={`grid-column: span ${it.span}`}
                  >
                    <span class="cell__title" data-ru={it.title.ru} data-en={it.title.en}>{it.title.ru}</span>
                    {it.sub && (
                      <span class="cell__sub" data-ru={it.sub.ru} data-en={it.sub.en}>{it.sub.ru}</span>
                    )}
                  </div>
                ))}
              </>
            ))
          }
        </div>

        <!-- checkpoints -->
        <div class="board__cps">
          <div class="cps__label" data-ru={t('checkpointsLabel','ru')} data-en={t('checkpointsLabel','en')}>
            {t('checkpointsLabel', 'ru')}
          </div>
          {
            Array.from({ length: 20 }, (_, i) => i + 1).map((d) => {
              const cp = cpByDay.get(d);
              return (
                <div class="cps__cell">
                  {cp && (
                    <div class:list={['cp', { 'cp--release': cp.release }]}>
                      <span class="cp__dot" />
                      <span class="cp__label">
                        <span data-ru={cp.text.ru} data-en={cp.text.en}>{cp.text.ru}</span>{' '}
                        <span class="cp__day" data-ru={cp.dayLabel.ru} data-en={cp.dayLabel.en}>{cp.dayLabel.ru}</span>
                      </span>
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <!-- legend -->
    <ul class="legend" aria-label="Легенда">
      {
        LEGEND.map((l) => (
          <li class="legend__chip" data-type={l.type}>
            <span class="legend__dot" />
            <span data-ru={l.label.ru} data-en={l.label.en}>{l.label.ru}</span>
          </li>
        ))
      }
    </ul>

    <!-- artist flow -->
    <section class="rm-sec">
      <div class="rm-sec__head">
        <span class="rm-sec__idx" data-ru={t('flowIdx','ru')} data-en={t('flowIdx','en')}>{t('flowIdx','ru')}</span>
        <h2 class="display">
          <span data-ru={t('flowTitleA','ru')} data-en={t('flowTitleA','en')}>{t('flowTitleA','ru')}</span>
          <em data-ru={t('flowTitleB','ru')} data-en={t('flowTitleB','en')}>{t('flowTitleB','ru')}</em>
        </h2>
      </div>
      <ol class="flow">
        {
          FLOW.map((f, i) => (
            <li class="flow__step">
              <span class="flow__num mono">{i + 1}</span>
              <span class="flow__lbl" data-ru={f.lbl.ru} data-en={f.lbl.en}>{f.lbl.ru}</span>
              <span class="flow__desc" data-ru={f.desc.ru} data-en={f.desc.en}>{f.desc.ru}</span>
            </li>
          ))
        }
      </ol>
      <p class="ios-note">
        <span class="ios-note__badge">iOS QA</span>
        <span>
          <strong data-ru={t('iosStrong','ru')} data-en={t('iosStrong','en')}>{t('iosStrong','ru')}</strong><span data-ru={t('iosText','ru')} data-en={t('iosText','en')}>{t('iosText','ru')}</span>
        </span>
      </p>
    </section>

    <!-- rules -->
    <section class="rm-sec">
      <div class="rm-sec__head">
        <span class="rm-sec__idx" data-ru={t('rulesIdx','ru')} data-en={t('rulesIdx','en')}>{t('rulesIdx','ru')}</span>
        <h2 class="display">
          <span data-ru={t('rulesTitleA','ru')} data-en={t('rulesTitleA','en')}>{t('rulesTitleA','ru')}</span>
          <em data-ru={t('rulesTitleB','ru')} data-en={t('rulesTitleB','en')}>{t('rulesTitleB','ru')}</em>
        </h2>
      </div>
      <div class="rules">
        {
          RULES.map((r) => (
            <article class="rule">
              <span class="mono rule__num">{r.num}</span>
              <h3 data-ru={r.h3.ru} data-en={r.h3.en}>{r.h3.ru}</h3>
              <p data-ru={r.p.ru} data-en={r.p.en}>{r.p.ru}</p>
            </article>
          ))
        }
      </div>
    </section>

    <footer class="rm-footer">
      <span data-ru={`${t('footerMain','ru')} · ${year}`} data-en={`${t('footerMain','en')} · ${year}`}>
        {t('footerMain', 'ru')} · {year}
      </span>
      <span class="rm-footer__sig" data-ru={t('footerSig','ru')} data-en={t('footerSig','en')}>
        {t('footerSig', 'ru')}
      </span>
    </footer>
  </div>
</Base>

<style>
  .rm {
    padding-block: clamp(32px, 5vw, 64px);
  }

  /* hero */
  .rm-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: clamp(24px, 4vw, 44px);
    margin-bottom: 36px;
  }

  .rm-hero__title {
    font-size: clamp(30px, 5vw, 56px);
    margin-top: 16px;
  }

  .rm-hero__lede {
    max-width: 52ch;
    color: var(--text-2);
    margin-top: 14px;
  }

  .rm-hero__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    flex-shrink: 0;
  }

  .lang-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--glass);
  }

  .lang-toggle button {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 6px 16px;
    border-radius: 999px;
    color: var(--text-2);
    transition:
      color 0.2s var(--ease),
      background 0.2s var(--ease);
  }

  .lang-toggle button.is-active {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-contrast);
    box-shadow: 0 6px 16px -6px var(--glow);
  }

  .rm-home {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .rm-home:hover {
    color: var(--accent-ink);
  }

  .rm-stats {
    display: flex;
    gap: 10px;
  }

  .rm-stats div {
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: 12px 18px;
    text-align: center;
  }

  .rm-stats dd {
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .rm-stats dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-3);
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .rm-hero {
      flex-direction: column;
      align-items: stretch;
    }

    .rm-hero__side {
      align-items: flex-start;
    }
  }

  /* board */
  .rm-scroll-hint {
    display: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .board-scroll {
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .board {
    min-width: 1500px;
  }

  @media (max-width: 1560px) {
    .rm-scroll-hint {
      display: block;
    }
  }

  .board__weeks,
  .board__days,
  .board__cal,
  .board__cps {
    display: grid;
    grid-template-columns: 130px repeat(20, minmax(56px, 1fr));
    gap: 4px;
  }

  .board__weeks {
    margin-bottom: 12px;
  }

  .wk {
    grid-column: span 5;
    position: relative;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    padding: 14px 16px 12px;
  }

  .wk::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--wc);
    box-shadow: 0 0 12px var(--wc);
  }

  .wk__num {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--wc);
  }

  .wk__title {
    display: block;
    font-weight: 700;
    font-size: 14px;
    margin-top: 3px;
  }

  .board__days {
    margin-bottom: 8px;
  }

  .day {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    padding-block: 6px;
    position: relative;
  }

  .day__num {
    display: block;
    font-size: 13px;
    color: var(--text-2);
    font-weight: 700;
  }

  .day--wb::before {
    content: '';
    position: absolute;
    left: -2px;
    top: -8px;
    bottom: -8px;
    width: 1px;
    background: var(--line-2);
    opacity: 0.4;
  }

  .role {
    position: relative;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 10px 12px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .role::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 999px;
    background: var(--rc, var(--text-3));
    box-shadow: 0 0 10px var(--rc, transparent);
  }

  .role[data-role='founder'] { --rc: var(--ph-polish); }
  .role[data-role='lead'] { --rc: var(--ph-dev); }
  .role[data-role='third'] { --rc: var(--ph-assets); }
  .role[data-role='artist'] { --rc: var(--ph-rel); }

  .role__tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  .role__name {
    font-weight: 700;
    font-size: 14px;
    margin-top: 3px;
  }

  .role__sub {
    font-size: 11.5px;
    color: var(--text-2);
  }

  .cell {
    background: color-mix(in srgb, var(--cc) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--cc) 40%, transparent);
    border-radius: var(--radius-sm);
    min-height: 72px;
    padding: 8px 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .cell--concept { --cc: var(--ph-concept); }
  .cell--assets { --cc: var(--ph-assets); }
  .cell--dev { --cc: var(--ph-dev); }
  .cell--polish { --cc: var(--ph-polish); }
  .cell--mkt { --cc: var(--ph-mkt); }
  .cell--rel { --cc: var(--ph-rel); }
  .cell--buf { --cc: var(--ph-buf); border-style: dashed; }

  .cell--strong {
    border-color: var(--cc);
    box-shadow: 0 0 18px -6px var(--cc);
  }

  .cell__title {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .cell--strong .cell__title {
    color: var(--cc);
  }

  .cell__sub {
    font-size: 10.5px;
    color: var(--text-2);
    margin-top: 3px;
    line-height: 1.3;
  }

  /* checkpoints */
  .board__cps {
    margin-top: 20px;
    padding-block: 20px 44px;
    position: relative;
  }

  .board__cps::before {
    content: '';
    position: absolute;
    left: 134px;
    right: 0;
    top: 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-2), transparent);
  }

  .cps__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-3);
    align-self: center;
  }

  .cps__cell {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 26px;
  }

  .cp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cp__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ph-buf);
    box-shadow: 0 0 14px var(--ph-buf);
    z-index: 1;
  }

  .cp--release .cp__dot {
    background: var(--ph-polish);
    box-shadow: 0 0 14px var(--ph-polish);
  }

  .cp__label {
    position: absolute;
    top: 20px;
    white-space: nowrap;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--ph-buf) 55%, transparent);
    border-radius: 999px;
    background: var(--glass);
    color: var(--ph-buf);
  }

  .cp--release .cp__label {
    border-color: color-mix(in srgb, var(--ph-polish) 55%, transparent);
    color: var(--ph-polish);
    transform: translateX(-24px);
  }

  .cp__day {
    opacity: 0.65;
    font-weight: 400;
  }

  /* legend */
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .legend__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-2);
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
  }

  .legend__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lc, var(--text-3));
    box-shadow: 0 0 10px var(--lc, transparent);
  }

  .legend__chip[data-type='concept'] { --lc: var(--ph-concept); }
  .legend__chip[data-type='assets'] { --lc: var(--ph-assets); }
  .legend__chip[data-type='dev'] { --lc: var(--ph-dev); }
  .legend__chip[data-type='polish'] { --lc: var(--ph-polish); }
  .legend__chip[data-type='mkt'] { --lc: var(--ph-mkt); }
  .legend__chip[data-type='rel'] { --lc: var(--ph-rel); }
  .legend__chip[data-type='buf'] { --lc: var(--ph-buf); }
  .legend__chip[data-type='checkpoint'] { --lc: var(--accent); }

  /* sections */
  .rm-sec {
    margin-top: clamp(56px, 8vw, 88px);
  }

  .rm-sec__head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 14px;
    margin-bottom: 28px;
  }

  .rm-sec__idx {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-ink);
    white-space: nowrap;
    padding: 4px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--glass);
  }

  .rm-sec h2 {
    font-size: clamp(22px, 3.4vw, 34px);
  }

  .rm-sec h2 em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* flow */
  .flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }

  .flow__step {
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 18px 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }

  .flow__num {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-contrast);
    font-weight: 700;
    box-shadow: 0 8px 20px -8px var(--glow);
  }

  .flow__lbl {
    font-weight: 700;
    font-size: 14px;
    line-height: 1.3;
  }

  .flow__desc {
    font-size: 12.5px;
    color: var(--text-2);
    line-height: 1.45;
  }

  @media (max-width: 1000px) {
    .flow {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 560px) {
    .flow {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ios-note {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 20px;
    margin-top: 18px;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .ios-note strong {
    color: var(--text);
  }

  .ios-note__badge {
    background: linear-gradient(135deg, var(--ph-polish), color-mix(in srgb, var(--ph-polish) 70%, var(--accent)));
    color: var(--accent-contrast);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 6px 16px -8px var(--ph-polish);
  }

  /* rules */
  .rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .rule {
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 20px 22px;
  }

  .rule__num {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: linear-gradient(100deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .rule h3 {
    font-size: 17px;
    margin-top: 10px;
  }

  .rule p {
    font-size: 14px;
