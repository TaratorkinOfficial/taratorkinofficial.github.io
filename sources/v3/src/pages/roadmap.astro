    font-size: 12.5px;
    color: var(--text-3);
  }

  .rm-footer__sig {
    letter-spacing: 0.02em;
  }
</style>

<script>
  // Bilingual toggle: every translatable node carries data-ru/data-en.
  type Lang = 'ru' | 'en';
  const KEY = 'roadmap_lang';

  function apply(lang: Lang) {
    document.documentElement.lang = lang;
    document.querySelectorAll<HTMLElement>('[data-ru]').forEach((el) => {
      const text = el.dataset[lang];
      if (text !== undefined) el.textContent = text;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((b) => {
      const active = b.dataset.lang === lang;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    document.title =
      lang === 'ru' ? 'Дорожная карта · Taratorkin Official' : 'Sprint roadmap · Taratorkin Official';
  }

  function detect(): Lang {
    const url = new URLSearchParams(location.search).get('lang');
    if (url === 'ru' || url === 'en') return url;
    try {
      const saved = localStorage.getItem(KEY);
      if (saved === 'ru' || saved === 'en') return saved;
    } catch {}
    return (navigator.language || '').toLowerCase().startsWith('ru') ? 'ru' : 'en';
  }

  function init() {
    const toggle = document.querySelector<HTMLElement>('.lang-toggle');
    if (!toggle || toggle.hasAttribute('data-lang-ready')) return;
    toggle.setAttribute('data-lang-ready', '');
    apply(detect());
    document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((b) => {
      b.addEventListener('click', () => {
        const lang = b.dataset.lang as Lang;
        try {
          localStorage.setItem(KEY, lang);
        } catch {}
        apply(lang);
      });
    });
  }

  // Run immediately too: on a first client-side (View Transitions) visit this
  // module can finish loading AFTER astro:page-load has already fired.
  init();
  document.addEventListener('astro:page-load', init);
</script>
